NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated, only providers actually enabled in Supabase.
# Leave empty until the OAuth apps exist — buttons are hidden when unset.
# AUTH_PROVIDERS=github,google
AUTH_PROVIDERS=

# --- M3: prices ---

# Supabase secret key. Bypasses RLS, so it is only ever used by price
# ingestion, which writes to tables that deliberately have no insert policy.
# Never expose it to the browser and never use it to read user rows.
SUPABASE_SECRET_KEY=

# Massive (formerly Polygon.io). Free "Stocks Basic" tier is enough: the
# grouped-daily endpoint returns every US ticker for one date in a single
# call, so the whole universe costs one request per trading day.
# No NEXT_PUBLIC_ prefix — this one costs money.
MASSIVE_API_KEY=

# Shared secret for /api/cron/prices. Vercel sends it as `Authorization:
# Bearer <value>` when a variable of this exact name exists, so the route can
# tell a real cron run from anyone who found the URL. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
