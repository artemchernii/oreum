# Скопіюй у .env.local і встав свої значення.
# Supabase Dashboard → Settings → API.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Публічний за задумом, тримається на RLS.
# Secret key (sb_secret_...) сюди НЕ клади — він обходить RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
